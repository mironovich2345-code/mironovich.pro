# ─── ОБЯЗАТЕЛЬНЫЕ ─────────────────────────────────────────────────────────────

# Абсолютный адрес сайта: canonical, OpenGraph, robots, sitemap, JSON-LD.
# Без завершающего слэша.
NEXT_PUBLIC_SITE_URL=https://mironovich.pro

# Telegram-бот, которому уходят заявки. Токен серверный — без префикса
# NEXT_PUBLIC он никогда не попадает в клиентский бандл.
# Пока пусто, форма честно сообщает об ошибке доставки и предлагает
# написать напрямую. Ложный success не показывается никогда.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── ОПЦИОНАЛЬНЫЕ ─────────────────────────────────────────────────────────────

# Поля «Компания» и «Направление» в форме заявки. Они расширяют состав
# персональных данных, поэтому включаются (=1) только после публикации
# согласованной политики конфиденциальности и согласия. Пока пусто — форма
# собирает только имя, контакт и описание задачи, а сервер игнорирует
# лишние поля, даже если их прислали.
NEXT_PUBLIC_LEAD_FORM_EXTENDED=

# Контакты. Подтверждённые адреса заданы в config/contacts.ts и используются
# по умолчанию. Переменные нужны, только чтобы их заменить: принимается
# https-ссылка на t.me / instagram.com; некорректная ссылка или старый адрес
# игнорируются, и остаётся подтверждённый.
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Аналитика — только Яндекс Метрика (GA4 отключён окончательно; NEXT_PUBLIC_GA_ID
# и NEXT_PUBLIC_ANALYTICS_CONSENT больше не читаются). Пока ID пустой или
# некорректный — скрипт не загружается, внешних запросов нет, домен не открывается
# в CSP. С ID показывается cookie-баннер, и Метрика загружается только после
# «Разрешить» — это не настраивается. Формат: только цифры.
NEXT_PUBLIC_YANDEX_METRICA_ID=

# Лимит заявок по IP. Пусто — безопасный режим (только общий лимит 10/мин).
# x-real-ip — только после проверки, что edge Railway перезаписывает заголовок
# (docs/release/rate-limit.md).
RATE_LIMIT_CLIENT_IP=

# Только для staging и других копий сайта: 1 — robots.txt запрещает обход,
# каждый ответ получает X-Robots-Tag: noindex. В production НЕ задавать.
SITE_NOINDEX=

# Часовой пояс для даты в сообщении бота.
LEAD_TIMEZONE=Europe/Moscow

# ИИ-разбор инструментов: ТОЛЬКО сервер. По умолчанию выключен.
# Дополнительно требуется согласовать и изменить externalProcessingApproved
# в config/ai-recommendations.ts; одних переменных для включения недостаточно.
# Не использовать NEXT_PUBLIC_* и не коммитить реальный ключ.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
AI_RECOMMENDATIONS_ENABLED=false
