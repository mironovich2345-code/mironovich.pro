{
  "name": "mironovich-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/print-versions.mjs",
    "build": "next build",
    "build:local": "node scripts/build-local.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev",
    "test": "node --test --experimental-strip-types \"tests/*.test.mjs\"",
    "release:check": "node scripts/release-check.mjs",
    "career:migrate": "node --experimental-strip-types scripts/career/runtime.mjs migrate",
    "career:build": "node --experimental-strip-types scripts/career/runtime.mjs build",
    "career:start": "node --experimental-strip-types scripts/career/runtime.mjs start",
    "career:cleanup": "node --experimental-strip-types scripts/career/runtime.mjs cleanup",
    "career:fixtures": "node --experimental-strip-types scripts/career/fixtures.mjs",
    "career:mail": "node --experimental-strip-types scripts/career/runtime.mjs mail",
    "career:test:integration": "node --experimental-strip-types tests/career-integration.mjs",
    "career:test:browser": "node tests/career-browser.mjs",
    "career:local:init": "node scripts/career/local-sandbox.mjs init",
    "career:local:verify": "node scripts/career/local-sandbox.mjs verify",
    "career:local:start": "node scripts/career/local-sandbox.mjs start",
    "career:local:gate": "node scripts/career/local-sandbox.mjs gate",
    "career:local:otp": "node scripts/career/local-sandbox.mjs otp",
    "career:local:destroy": "node scripts/career/local-sandbox.mjs destroy"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "next": "15.5.28",
    "nodemailer": "^10.6.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "mailparser": "^3.14.5",
    "postcss": "^8.4.49",
    "smtp-server": "^3.21.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    },
    "source-map-js": "^1.2.2"
  }
}
