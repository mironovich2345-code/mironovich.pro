# Closed synthetic-only Railway preview. Never use production or real customer data.
CAREER_SANDBOX_ENABLED=1
CAREER_ENVIRONMENT=synthetic-sandbox
CAREER_ONLY_SYNTHETIC=true
CAREER_APP_ORIGIN=http://127.0.0.1:3300
CAREER_DATABASE_URL=postgresql://postgres@127.0.0.1:55433/mironovich_career_test
CAREER_DATABASE_HOST=127.0.0.1:55433
CAREER_DATABASE_NAME=mironovich_career_test
CAREER_SESSION_SECRET=
CAREER_TESTER_SECRET=
# yookassa on Railway; fixture only on loopback with an explicitly started local fixture.
CAREER_PAYMENT_MODE=fixture
YOOKASSA_SHOP_ID=
YOOKASSA_TEST_SECRET_KEY=
YOOKASSA_TEST_KEY_ROTATED=false
CAREER_PROVIDER_FIXTURE_URL=http://127.0.0.1:3305
CAREER_FIXTURE_CONTROL_SECRET=
CAREER_SMTP_READY=false
CAREER_SMTP_HOST=127.0.0.1
CAREER_SMTP_PORT=2526
CAREER_SMTP_USER=
CAREER_SMTP_PASSWORD=
CAREER_SMTP_TEST_RECIPIENT=

# External AI pilot: OFF by default; NEVER use real customer or employer data.
# Model is fixed server-side; no AI requests from Railway/production.
CAREER_AI_MODE=rules
CAREER_AI_ENABLED=0
OPENAI_API_KEY=
