@@ -0,0 +1,45 @@
+/**
+ * Fixed-window rate limiter kept in process memory (per warm instance).
+ *
+ * Every IP is forgotten at most `windowMs` after its last request: a sweep runs
+ * on a timer and on each call, so addresses never linger until a restart. The
+ * number of tracked addresses is capped; when full, the least recently seen are
+ * evicted first (instead of wiping everyone's counters at once).
+ */
+export function createRateLimiter({
+  windowMs = 60_000,
+  max = 5,
+  maxKeys = 5000,
+  now = () => Date.now(),
+  timer = true,
+}: { windowMs?: number; max?: number; maxKeys?: number; now?: () => number; timer?: boolean } = {}) {
+  // insertion order = recency: an IP is re-inserted on every request
+  const hits = new Map<string, number[]>();
+  let lastSweep = 0;
+
+  const sweep = (t = now()) => {
+    for (const [ip, times] of hits) {
+      if (t - times[times.length - 1] >= windowMs) hits.delete(ip);
+    }
+    lastSweep = t;
+  };
+
+  if (timer) {
+    const id = setInterval(() => sweep(), windowMs);
+    // never keep the process alive just for this
+    (id as { unref?: () => void }).unref?.();
+  }
+
+  const limited = (ip: string): boolean => {
+    const t = now();
+    if (t - lastSweep >= windowMs) sweep(t);
+    const recent = (hits.get(ip) ?? []).filter((x) => t - x < windowMs);
+    recent.push(t);
+    hits.delete(ip);
+    hits.set(ip, recent);
+    while (hits.size > maxKeys) hits.delete(hits.keys().next().value as string);
+    return recent.length > max;
+  };
+
+  return { limited, sweep, size: () => hits.size };
+}
